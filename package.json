{
  "name": "dsh-deepsleep-progress",
  "version": "0.1.1",
  "type": "module",
  "description": "DSH Web plugin: an elapsed/budget progress bar with a moving head image under blocking tool calls (wait_agent, job_output, bash, ask_user_question), plus a graphical settings page.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  },
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "progress-bar",
    "deepsleep"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xyzYaeMiko/dsh-deepsleep-progress.git"
  },
  "homepage": "https://github.com/xyzYaeMiko/dsh-deepsleep-progress#readme",
  "bugs": {
    "url": "https://github.com/xyzYaeMiko/dsh-deepsleep-progress/issues"
  }
}
